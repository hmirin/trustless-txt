{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trustless-txt",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trustless-txt",
      "database_id": "56bb92cd-fbc4-4e8a-bd9e-338a20d56813",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DB_MAX_SIZE_BYTES": "419430400"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "routes": [
    {
      "pattern": "text.numeri.xyz",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": false
  }
}
